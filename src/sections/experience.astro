---
const experienceMap = [
  {
    period: "2021 — 2026",
    regime: "Remoto",
    responsibility: "Front-End",
    company: "Onze Corretora de Seguros",
    tasks: [
      "Novas soluções, manutenção e plantão de emergências (orientações e correções de bugs).",
      "Manutenção do app em React Native.",
    ],
  },
  {
    period: "2020 — 2021",
    regime: "Remoto",
    responsibility: "Front-End",
    company: "mLabs — Gestão de Redes Sociais",
    tasks: [
      "Time de ads evoluindo a ferramenta integrada ao Facebook. Primeiro contato com Ember.js.",
    ],
  },
  {
    period: "2019",
    regime: "Presencial",
    responsibility: "Front-End",
    company: "GSW · Embraer",
    tasks: [
      "Consultoria na Embraer — primeiro contato com React, reconstruindo o front-end de faturas.",
    ],
  },
  {
    period: "2018 — 2019",
    regime: "Presencial",
    responsibility: "Front-End",
    company: "Mult-e · Embraer",
    tasks: [
      "Com o time de design, telas promocionais e de notícias para a intranet da Embraer.",
    ],
  },
  {
    period: "2014 — 2018",
    regime: "Presencial",
    responsibility: "Front-End",
    company: "CSS4HTML",
    tasks: [
      "Layouts de campanhas para marcas e agências. Front-ends em Rails com HTML, CSS e jQuery.",
    ],
  },
];
---

<section class="py-20 lg:py-24" id="experience">
  <p class="font-mono text-[13px] uppercase tracking-[0.2em] text-accent">
    02 — experiência
  </p>
  <h2 class="mt-3 text-4xl lg:text-5xl font-bold tracking-[-0.02em]">
    Trajetória profissional
  </h2>
  <div class="mt-14 border-t border-hairline divide-y divide-hairline">
    {
      experienceMap.map(
        ({ period, regime, responsibility, company, tasks }, i) => (
          <article class="py-8 grid gap-4 md:grid-cols-[200px_1fr_32px] md:gap-10">
            <div>
              <p class="font-mono text-[13px] uppercase tracking-[0.15em] text-accent-soft">
                {period}
              </p>
              <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted mt-2">
                {regime}
              </p>
            </div>
            <div>
              <h3 class="text-xl font-semibold">
                {responsibility}{" "}
                <span class="text-muted font-normal">— {company}</span>
              </h3>
              <ul class="mt-3 space-y-2 text-muted text-[15px] leading-relaxed max-w-2xl">
                {tasks.map((task) => (
                  <li>{task}</li>
                ))}
              </ul>
            </div>
            <span class="font-mono text-sm font-bold text-[#3A3A44] hidden md:block">
              0{i + 1}
            </span>
          </article>
        ),
      )
    }
  </div>
</section>
