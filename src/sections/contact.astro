---
const socials = [
  { label: "github", href: "https://github.com/Marcos-Toledo" },
  {
    label: "linkedin",
    href: "https://www.linkedin.com/in/marcos-renato-de-toledo-5256377b",
  },
  { label: "e-mail direto", href: "mailto:marcostoledo.dev@gmail.com" },
];
---

<section class="py-24 lg:py-32 text-center" id="contact">
  <p class="font-mono text-[13px] uppercase tracking-[0.2em] text-accent">
    04 — contato
  </p>
  <h2
    class="mt-6 text-5xl lg:text-7xl font-bold tracking-[-0.03em] leading-[1.05]"
  >
    Vamos construir<br /><span class="text-accent">algo extraordinário.</span>
  </h2>
  <p class="mt-6 text-lg text-muted max-w-md mx-auto leading-7">
    Um projeto em mente ou só um olá — a caixa de entrada está aberta.
  </p>
  <a
    href="mailto:marcostoledo.dev@gmail.com"
    class="mt-10 inline-block text-xl lg:text-2xl font-semibold underline decoration-accent decoration-2 underline-offset-8 hover:text-accent transition-colors"
  >
    marcostoledo.dev@gmail.com ↗
  </a>
  <div class="mt-12 flex flex-wrap justify-center gap-3">
    {
      socials.map(({ label, href }) => (
        <a
          class="font-mono text-xs uppercase tracking-[0.12em] border border-hairline rounded-full px-5 py-3 hover:border-accent hover:text-accent transition-colors"
          href={href}
          target={href.startsWith("mailto:") ? undefined : "_blank"}
          rel="noopener noreferrer"
        >
          {label}
        </a>
      ))
    }
  </div>
  <!-- <div class="mt-16 max-w-xl mx-auto text-left bg-surface p-8 rounded-3xl border border-hairline">
    <ContactForm />
  </div> -->
</section>
