    class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-16 flex flex-col md:flex-row justify-between items-center gap-3"
  >
    <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted">
      © {year} marcos toledo
    </p>
    <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted">
      feito com astro + tailwind
    </p>
    <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted">
      caçapava, sp — br
    </p>
  </div>
</footer>
