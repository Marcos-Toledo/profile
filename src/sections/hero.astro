---

---

<section class="pt-14 pb-16 lg:pt-24 lg:pb-22" id="about">
  <div class="flex flex-col lg:flex-row lg:items-start gap-14 lg:gap-20">
    <div class="flex-1 space-y-8">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="relative flex h-2.5 w-2.5">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent"
          ></span>
        </span>
        <p
          class="font-mono text-xs uppercase tracking-[0.15em] text-accent-soft"
        >
          Disponível para novos projetos
        </p>
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-muted">
          / Caçapava — Brasil
        </p>
      </div>
      <h1
        class="text-5xl sm:text-7xl lg:text-8xl font-bold tracking-[-0.03em] leading-[0.95]"
      >
        Desenvolvedor<br /><span class="text-accent">front-end.</span>
      </h1>
      <p class="text-lg text-muted max-w-xl leading-8">
        Olá, sou Marcos. Construo aplicações web há mais de uma década — hoje
        com React e TypeScript, antes com Ember, jQuery e Rails. Código limpo,
        experiências excepcionais.
      </p>
      <div class="flex flex-wrap gap-4 pt-2">
        <a
          href="#projects"
          class="bg-accent hover:bg-accent-soft text-ink font-semibold px-7 py-4 rounded-xl transition-colors"
        >
          ver projetos ↓
        </a>
        <a
          href="#contact"
          class="border border-hairline hover:border-accent hover:text-accent font-semibold px-7 py-4 rounded-xl transition-colors"
        >
          entrar em contato
        </a>
      </div>
    </div>
    <div class="w-[320px] max-w-full lg:w-[372px] shrink-0">
      <div class="relative">
        <div
          class="absolute inset-0 translate-x-4 translate-y-3 rotate-3 bg-accent/55 rounded-2xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative rounded-2xl overflow-hidden border border-hairline"
        >
          <img
            alt="Retrato profissional de Marcos Toledo"
            class="w-full aspect-[3/4] object-cover"
            src="./assets/images/IA-foto.jpeg"
          />
        </div>
      </div>
      <p
        class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted mt-4"
      >
        Marcos Toledo — retrato, 2026
      </p>
    </div>
  </div>
  <div
    class="mt-16 pt-8 border-t border-hairline flex flex-wrap gap-x-14 gap-y-6"
  >
    <div>
      <p class="text-3xl font-bold tracking-tight">11+</p>
      <p
        class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted mt-1"
      >
        anos de experiência
      </p>
    </div>
    <div>
      <p class="text-3xl font-bold tracking-tight">5</p>
      <p
        class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted mt-1"
      >
        empresas — consultorias e produto
      </p>
    </div>
    <div>
      <p class="text-3xl font-bold tracking-tight">remoto</p>
      <p
        class="font-mono text-[11px] uppercase tracking-[0.15em] text-muted mt-1"
      >
        trabalho distribuído, br → mundo
      </p>
    </div>
  </div>
</section>
