---
import { Icon } from "astro-icon/components";
import CV from "../../public/assets/file/20_de_abril_de_2026_CV.pdf";

const linksMap = [
  { label: "sobre", href: "#about" },
  { label: "experiência", href: "#experience" },
  { label: "projetos", href: "#projects" },
  { label: "contato", href: "#contact" },
];
---

<nav
  class="sticky top-0 z-50 w-full border-b border-hairline bg-background/80 backdrop-blur-md"
  id="main-nav"
>
  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-16">
    <div class="flex justify-between h-[76px] items-center">
      <a href="#about" class="flex items-center gap-3" aria-label="Início">
        <span
          class="size-[26px] bg-accent rounded-md flex items-center justify-center text-ink font-bold text-[13px]"
          >M</span
        >
        <span class="text-[15px] font-semibold tracking-tight"
          >marcos.toledo</span
        >
      </a>
      <div class="hidden md:flex items-center gap-9">
        {
          linksMap.map(({ label, href }, i) => (
            <a
              class="font-mono text-xs uppercase tracking-[0.12em] text-muted hover:text-foreground transition-colors"
              href={href}
            >
              <span class="text-accent-soft mr-1">0{i + 1}</span>
              {label}
            </a>
          ))
        }

        <button
          class="font-mono text-xs uppercase tracking-[0.12em] border border-hairline rounded-full px-5 py-2.5 hover:border-accent hover:text-accent transition-colors cursor-pointer"
          onclick={`window.open('${CV}')`}
        >
          baixar cv ↓
        </button>
      </div>
      <button
        type="button"
        class="md:hidden p-2 rounded-lg hover:bg-surface transition-colors aria-expanded:bg-surface"
        id="menu-toggle"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="material-symbols:menu" size="24" />
      </button>
    </div>
    <div
      id="mobile-menu"
      class="md:hidden hidden flex flex-col gap-4 text-center py-6 border-t border-hairline"
      role="menu"
    >
      {
        linksMap.map(({ label, href }, i) => (
          <a
            class="font-mono text-sm uppercase tracking-[0.12em] text-muted hover:text-foreground transition-colors py-2"
            href={href}
            role="menuitem"
          >
            <span class="text-accent-soft mr-1">0{i + 1}</span>
            {label}
          </a>
        ))
      }
      <button
        type="button"
        class="font-mono text-xs uppercase tracking-[0.12em] border border-hairline rounded-full px-5 py-3 hover:border-accent hover:text-accent transition-colors w-fit mx-auto cursor-pointer"
        onclick={`window.open('${CV}')`}
      >
        baixar cv ↓
      </button>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
    const isOpen = !menu?.classList.contains("hidden");
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
